{
  // ============================================================
  // 通用编辑器设置
  // ============================================================
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "editor.suggest.snippetsPreventQuickSuggestions": false,

  // ============================================================
  // C# / .NET
  // ============================================================
  "dotnet.defaultSolution": "DesignPatterns.slnx",
  "omnisharp.enableEditorConfigSupport": true,
  "omnisharp.enableRoslynAnalyzers": true,
  "dotnet.enableServerCodeModel": false,
  "dotnet.buildOnSave": false,
  "dotnet.restore.enableTelemetry": false,
  "dotnetBackgroundTerminal.environment": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "csharp.suppressDotnetRestoreNotification": true,
  "files.associations": {
    "*.slnx": "xml",
    "*.sln": "xml"
  },

  // ============================================================
  // 语言特定格式化器
  // ============================================================
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true
  },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on"
  },

  // ============================================================
  // 文件资源管理器排除
  // ============================================================
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true,
    "**/.idea": true,
    "**/.codegraph": true,
    "**/.omo": true,
    "**/.omo-cache": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/.github": true,
    "**/.cache": true,
    "**/logs": true,
    "**/backup": true,
    "**/_legacy": true,
    "**/dist": true
  },

  // ============================================================
  // 文件嵌套模式
  // ============================================================
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.cs": "${capture}.cs",
    "*.csproj": "*.props,*.targets,Directory.Build.props,Directory.Build.targets",
    "DesignPatterns.slnx": "*.csproj,.editorconfig,.gitignore,*.sln",
    "README.md": "LICENSE"
  }
}
